<h1>Список студентів</h1>

<ul class="collection">
    {{#each students}}
        <li class="collection-item">{{this.lastName}} {{this.firstName}} — Група: {{this.group}}</li>
    {{else}}
        <li class="collection-item">Студентів поки немає.</li>
    {{/each}}
</ul>

<a href="/students/add" class="btn waves-effect waves-light" style="margin-bottom: 15px;">Додати студента</a>